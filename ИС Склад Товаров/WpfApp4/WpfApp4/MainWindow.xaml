<Window x:Class="DonkeyRacingWarehouse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ослиные бега" 
        Height="900" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F5F5">

    <Window.Resources>
        <!-- Стили -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#FF333333"/>
        </Style>

        <Style x:Key="MinimalButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF333333"/>
            <Setter Property="BorderBrush" Value="#FF568458"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#20568458"/>
                    <Setter Property="Foreground" Value="#FF568458"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Margin" Value="0,0,0,30"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#FFCCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="SearchLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#FF666666"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель - навигация -->
        <Border Grid.Column="0" Background="White" Padding="40">
            <StackPanel>
                <TextBlock Text="Ослиные бега" 
                           Foreground="#FF568458"
                           Style="{StaticResource HeaderText}"/>
                <Button Content="Оформить товар" 
                        Style="{StaticResource MinimalButton}"
                        Click="Oformlenie_Click"/>

                <Button Content="Оформить доставку" 
                        Style="{StaticResource MinimalButton}"
                        Click="Dostavka_Click"/>

                <!-- Пустое пространство -->
                <StackPanel VerticalAlignment="Bottom" Margin="0,40,0,0">
                    <Rectangle Height="1" Fill="#FFEEEEEE" Margin="0,20,0,20"/>
                    <TextBlock Text="v1.0.0" Foreground="#FFAAAAAA" FontSize="10"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Основная область контента -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="40">
            <StackPanel>
                <TextBlock Text="Склад товаров" 
                           Style="{StaticResource SectionHeader}"/>

                <!-- Панель поиска с разделёнными категориями -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Поиск по названию -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Поиск по названию" Style="{StaticResource SearchLabel}"/>
                        <TextBox x:Name="NameSearchTextBox" 
                                 Style="{StaticResource SearchTextBox}"
                                 TextChanged="SearchTextBoxes_TextChanged"/>
                    </StackPanel>

                    <!-- Поиск по коду -->
                    <StackPanel Grid.Column="1" Margin="5,0,5,0">
                        <TextBlock Text="Поиск по коду" Style="{StaticResource SearchLabel}"/>
                        <TextBox x:Name="CodeSearchTextBox" 
                                 Style="{StaticResource SearchTextBox}"
                                 TextChanged="SearchTextBoxes_TextChanged"
                                 />
                    </StackPanel>

                    <!-- Поиск по поставщику -->
                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                        <TextBlock Text="Поиск по поставщику" Style="{StaticResource SearchLabel}"/>
                        <TextBox x:Name="SupplierSearchTextBox" 
                                 Style="{StaticResource SearchTextBox}"
                                 TextChanged="SearchTextBoxes_TextChanged"
                                 />
                    </StackPanel>

                    <!-- Кнопка сброса -->
                    <Button Grid.Column="3"
                            Content="Сбросить"
                            Margin="10,23,0,0"
                            Padding="15,8"
                            VerticalAlignment="Top"
                            Background="#FF568458"
                            Foreground="White"
                            BorderThickness="0"
                            Click="ClearSearchButton_Click"
                            />
                </Grid>

                <!-- Таблица с товарами -->
                <DataGrid x:Name="TovarDataGrid" HorizontalAlignment="Stretch" Margin="10" AutoGenerateColumns="True" Height="461" >

                </DataGrid>

                <!-- Кнопка перезагрузки и очистки таблицы -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10"/>
            </StackPanel>
        </ScrollViewer>
        <Button Content="Перезагрузить таблицу" 
                            Padding="15,8" 
                            Background="#FF568458" 
                            Foreground="White" 
                            BorderThickness="0"
                            Click="ReloadTable_Click" Grid.Column="1" Margin="410,653,252,199"/>
        <Button Content="Очистить таблицу" 
                            Padding="15,8" 
                            Background="#FF568458" 
                            Foreground="White" 
                            BorderThickness="0"
                            Margin="616,653,75,199"
                            Click="ClearTable_Click" Grid.Column="1"/>
    </Grid>
</Window>
