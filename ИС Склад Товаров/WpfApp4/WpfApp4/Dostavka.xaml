<Window x:Class="DonkeyRacingWarehouse.Dostavka"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформление доставки" Height="600" Width="800"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель поиска -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="SearchTextBox" 
                     Width="300" 
                     Padding="5"
                     VerticalAlignment="Center"
                     TextChanged="SearchTextBox_TextChanged"/>

            <ComboBox x:Name="SupplierFilter" 
                      Width="200" 
                      Margin="10,0,0,0"
                      VerticalAlignment="Center"
                      SelectionChanged="SupplierFilter_SelectionChanged">
                <ComboBoxItem>Имя поставщика</ComboBoxItem>
                <ComboBoxItem>Наименование товара</ComboBoxItem>
                <ComboBoxItem>Код товара</ComboBoxItem>
            </ComboBox>

            <Button Content="Сбросить" 
                    Margin="10,0,0,0"
                    Padding="10,5"
                    VerticalAlignment="Center"
                    Click="ClearSearchButton_Click"/>
        </StackPanel>

        <!-- Список товаров -->
        <DataGrid x:Name="ProductsGrid" 
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionChanged="ProductsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="100"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Поставщик" Binding="{Binding Supplier}" Width="200"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Панель оформления -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Text="Выбрано: " VerticalAlignment="Center"/>
            <TextBlock x:Name="SelectedCountText" Text="0" VerticalAlignment="Center" Margin="5,0,20,0"/>
            <Button Content="Оформить доставку" 
                    Padding="15,5"
                    Background="#FF568458"
                    Foreground="White"
                    Click="ConfirmDelivery_Click"/>
        </StackPanel>
    </Grid>
</Window>
