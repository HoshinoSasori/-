<Window x:Class="DonkeyRacingWarehouse.Oformlenie"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформление товара" 
        Height="400"  
    Width="400"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <StackPanel>
            <Label Content="Поставщик (ИП или ООО):"/>
            <TextBox x:Name="SupplierTextBox" Margin="0,5,0,15"/>

            <Label Content="Наименование товара:"/>
            <TextBox x:Name="ProductNameTextBox" Margin="0,5,0,15"/>

            <Label Content="Количество (шт):"/>
            <TextBox x:Name="QuantityTextBox" Margin="0,5,0,20"
                     />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Width="100" Margin="0,10,0,0" />
                <Button Content="Сохранить" Width="100" Margin="10,10,0,0"
                        Background="#FF568458" Foreground="White" 
                        Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>